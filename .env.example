# Environment Configuration for Node.js AEP Client

# Node.js Application
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Asterisk AEP Configuration
ASTERISK_HOST=127.0.0.1
ASTERISK_AEP_PORT=4573
AEP_SECRET=aeap_secret_key_123

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=/workspace/service-account-key.json
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=callcenter
DB_USER=callcenter_user
DB_PASSWORD=your_password

# Speech Configuration
TTS_VOICE=th-TH-Standard-A
STT_LANGUAGE=th-TH
MAX_SPEECH_ATTEMPTS=3
SPEECH_TIMEOUT=10
SILENCE_THRESHOLD=3